def objective(trial):
    # Hyperparameters to search
    lr = trial.suggest_float("lr", 1e-5, 1e-3, log=True)
    weight_decay = trial.suggest_float("weight_decay", 1e-4, 1e-1, log=True)
    batch_size = trial.suggest_categorical("batch_size", [8, 16, 32, 64])

    train_loader = DataLoader(
        train_dataset, batch_size=batch_size, shuffle=True, drop_last=True
    )
    val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False)

    model = timm.create_model("vit_base_patch16_224", pretrained=True, num_classes=2)
    model = model.to(device)

    criterion = nn.CrossEntropyLoss()
    optimizer = optim.AdamW(model.parameters(), lr=lr, weight_decay=weight_decay)

    epochs = 3
    for epoch in range(epochs):
        # --- Training Phase ---
        model.train()
        for images, labels in train_loader:
            images, labels = images.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(images)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()

        # --- Validation Phase ---
        model.eval()
        all_targets = []
        all_probs = []

        with torch.no_grad():
            for images, labels in val_loader:
                images, labels = images.to(device), labels.to(device)
                outputs = model(images)

                # Convert logits to probabilities and grab positive class (index 1)
                probs = torch.softmax(outputs, dim=1)[:, 1]

                all_probs.extend(probs.detach().cpu().numpy())
                all_targets.extend(labels.detach().cpu().numpy())

        # Ensure both classes are present in the validation set before computing AUC
        if len(np.unique(all_targets)) > 1:
            val_auroc = roc_auc_score(all_targets, all_probs)
        else:
            val_auroc = 0.5  # Fallback baseline if a batch or split lacks one class

        # Optuna pruning checkpoint
        trial.report(val_auroc, epoch)
        if trial.should_prune():
            raise optuna.exceptions.TrialPruned()

    return val_auroc

