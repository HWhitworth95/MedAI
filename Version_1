@torch.no_grad()
def collect_energies(model, loader):
    """Energy score E(x) = -logsumexp(logits). Higher = less familiar to the model."""
    model.eval()
    energies = []
    for images, _ in loader:
        logits = model(images.to(device))
        energies.append(-torch.logsumexp(logits, dim=1).cpu())
    return torch.cat(energies).numpy()

