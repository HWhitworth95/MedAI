def vit_reshape(tokens, h=14, w=14):
    patches = tokens[:, 1:, :].reshape(tokens.size(0), h, w, tokens.size(2))
    #first token is classifier token hwich we dont need because we only care about spatial. can slice this out using tokens[:,1:,:] which should just remove first token so we kep the 196 patch tokens
    #shape changes from [B, 197, D] to [B, 196, D] (B --> Batch Size, D --> Embedding)

    #For The analyis we dont want the 196 linear data rather we want in a grid. Therefore patches.reshape(tokens.size(0), h,w, tokens.size(2))

    '''
    tokens.size(0)  # Returns 1    (Batch size)
    tokens.size(1)  # Returns 197  (Number of tokens: 1 CLS + 196 Patches)
    tokens.size(2)  # Returns 768  (Feature dimension size)
    '''
    
    return patches.permute(0, 3, 1, 2) #Shape change: From [B, 14, 14, D] → [B, D, 14, 14].


def run_gradcam(model, x, target): # 'model' is the trained vision transformer , 'x'is the input tensor (preprocessd) and 'target' is the ID class we want to explain
    layer = model.blocks[-2].norm1 #Isolate the layer nomalisation inside the final transformer encoder blocks
    with GradCAM(model=model, target_layers=[layer], reshape_transform=vit_reshape) as cam:
        heat = cam(input_tensor=x, targets=[ClassifierOutputTarget(target)])
    return heat[0], {}

