class ViTAnalyser:

  def __init__(self, model, transform, min_side = 224, brightness_lim=(20, 235)):
    self.model = model
    self.transform = transform
    self.min_side = min_side
    self.brightness_lim = brightness_lim

  # Next gen development to consider brightness and blur boundaires but more experementation required.
  def prepare_image(self, state: AuditState) -> dict:
      with Image.open(state["image_path"]) as image:
          image = ImageOps.exif_transpose(image).convert("RGB")
          image = image.resize((224, 224), Image.Resampling.BICUBIC)

          prepared_path = state["image_path"] + ".prepared.png"
          image.save(prepared_path)

      return {
          "image_path": prepared_path,
          "status": "ready",
      }

  def predict_image(self, state: AuditState) -> dict:
    #We want to run our image through the prediction model
    with Image.open(state["image_path"]) as image:
      image = image.convert("RGB")
      inputs = self.transform(image).unsqueeze(0) #adds batch dim
    
    device = next(self.model.paramters()).device
    inputs = inputs.to(device)

    self.model.eval()

    outputs = self.model(inputs)
    probs = torch.softmax(outputs, dim=1)

    confidence, predictions = probs.max(dim=1)
      
    return {
        "prediction": predictions.item(),
        "confidence": confidence.item()
    }
    

    

