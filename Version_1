def route_quality(state: AuditState) -> str:
    return "report" if state["status"] == "rejected_quality" else "predict_image"


def route_ood(state: AuditState):
    """Either abstain straight to the report, or fan out one XAI task per method.
    A LangGraph router may return a node name OR a list of Sends."""
    if state["ood_flag"]:
        return "report"
    return dispatch_xai(state)


def human_review(state: AuditState) -> dict:
    """Pause the graph and hand the case to a person. Resumed with Command(resume=...)."""
    decision = interrupt({
        "case_id": state["case_id"],
        "prediction": state["prediction"],
        "llm_review": state["llm_review"],
        "question": "Accept, reject, or override the prediction? Add a note.",
    })
    return {"reviewer": decision, "status": "human_reviewed"}


def report(state: AuditState) -> dict:
    """One markdown record per case, whichever path it took."""
    lines = [f"# Audit: {state['case_id']}", f"**Final status:** {state['status']}", ""]

    problems = state.get("quality", {}).get("problems")
    if problems:
        lines.append("**Image rejected:** " + "; ".join(problems))
        return {"report": "\n".join(lines)}

    p = state["prediction"]
    lines.append(f"**Prediction:** {p['class_name']} ({p['confidence']:.1%})")
    lines.append(f"**Energy:** {state['energy']:.3f} (threshold {ENERGY_THRESHOLD:.3f})")

    if state.get("ood_flag"):
        lines.append("**Abstained:** input looks out-of-distribution; no explanation produced.")
        return {"report": "\n".join(lines)}

    lines += ["", "| Method | Border frac | Top-10% frac |", "|---|---|---|"]
    for e in state["explainations"]:
        lines.append(f"| {e['method']} | {e['border_frac']:.3f} | {e['top10_frac']:.3f} |")
    lines.append(f"\n**Mean Spearman rho:** {state['agreement']['mean_rho']:.3f}")

    r = state["llm_review"]
    lines += ["", f"**LLM verdict:** {r['verdict']}", r["rationale"]]
    lines += [f"- {c}" for c in r["concerns"]]

    if state.get("reviewer"):
        lines += ["", f"**Human reviewer:** {state['reviewer']}"]

    return {"report": "\n".join(lines)}

def route_after_review(state: AuditState) -> str:
    """Send flagged cases to a human when running interactively; everything else to the report."""
    review = state["llm_review"]
    flagged = review["recommend_human_review"] or review["verdict"] != "supported"
    return "human_review" if flagged and state.get("interactive") else "report"

def build_audit_graph(analyser: ViTAnalyser):
    g = StateGraph(AuditState)

    g.add_node("prepare_image", analyser.prepare_image)
    g.add_node("predict_image", analyser.predict_image)
    g.add_node("ood_detect", analyser.ood_detect)
    g.add_node("run_xai", run_xai)                # receives an XAITask via Send, not AuditState
    g.add_node("compare_methods", compare_methods)
    g.add_node("llm_review", llm_review)
    g.add_node("human_review", human_review)
    g.add_node("report", report)

    g.add_edge(START, "prepare_image")
    g.add_conditional_edges("prepare_image", route_quality, ["predict_image", "report"])
    g.add_edge("predict_image", "ood_detect")
    g.add_conditional_edges("ood_detect", route_ood, ["run_xai", "report"])
    g.add_edge("run_xai", "compare_methods")      # waits for all three branches
    g.add_edge("compare_methods", "llm_review")
    g.add_conditional_edges("llm_review", route_after_review, ["human_review", "report"])
    g.add_edge("human_review", "report")
    g.add_edge("report", END)

    return g.compile(checkpointer=MemorySaver())  # checkpointer is required for interrupt()


analyser = ViTAnalyser(model, eval_transform, energy_threshold=ENERGY_THRESHOLD)
audit_graph = build_audit_graph(analyser)
IPython.display.display(IPython.display.Image(audit_graph.get_graph().draw_mermaid_png()))


def run_case(image_path, interactive=False):
    """Run one image through the graph with its own thread, so checkpoints don't mix."""
    case_id = str(uuid.uuid4())[:8]
    config = {"configurable": {"thread_id": case_id}}
    result = audit_graph.invoke(
        {"case_id": case_id, "image_path": image_path, "interactive": interactive}, config
    )
    return result, config


