'''
The next step is to turn each saliency map into a few numbers that an analyst. There are three pieces:

Normalise every map the same way, so the methods are comparable.
Summarise each map with border fraction and top-10% fraction.
Compare the methods pairwise with Spearman ρ.
'''

def normalise_map(m, size=224):
    """Resize to size x size, take magnitudes, and scale so the map sums to 1."""
    m = np.abs(np.asarray(m, dtype=np.float32))
    if m.shape != (size, size):
        t = torch.from_numpy(m)[None, None]                       # [1, 1, H, W] for interpolate
        m = F.interpolate(t, size=(size, size), mode="bilinear",
                          align_corners=False)[0, 0].numpy()
    total = m.sum()
    return m / total if total > 0 else m                          # ← must be outside the if


def border_frac(m, margin=0.10):
    """Share of attribution mass in the outer `margin` band of the image.
    High values suggest shortcut learning (L/R markers, text, collimation edges).
    Reference point: a uniform map gives 1 - (1 - 2*margin)^2 = 0.36 at margin=0.10."""
    b = int(m.shape[0] * margin)
    interior = m[b:-b, b:-b].sum()
    return float(m.sum() - interior)


def top_frac(m, q=0.10):
    """Share of mass held by the top q fraction of pixels, i.e. how concentrated the map is.
    Uniform map -> q (0.10); a sharply focused map -> close to 1."""
    flat = np.sort(m.ravel())[::-1]
    k = int(np.ceil(q * flat.size))
    return float(flat[:k].sum())


def summarise_map(m):
    return {"border_frac": border_frac(m), "top10_frac": top_frac(m)}

