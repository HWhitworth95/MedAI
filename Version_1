class ViTAnalyser:
    def __init__(self, model, transform, energy_threshold = -1.388, min_side=224, brightness_lim=(20, 235)):
        self.model = model
        self.transform = transform
        self.energy_threshold = energy_threshold
        self.min_side = min_side
        self.brightness_lim = brightness_lim

    def prepare_image(self, state: AuditState) -> dict:
        try:
            with Image.open(state["image_path"]) as image:
                image = ImageOps.exif_transpose(image).convert("L")  #This may be redundant but using PIL might case issues w/raw image so we wnat to read meta data and rotate if needed, exif_transpose(x) should always make right side up and get rid of orientation tag. '.convert("L")' converts to greyscale, once again may be redundant but not sure.
                arr = np.asarray(image, dtype=np.float32) #convert image to numpy 32bit array
                w, h = image.size #Reads image height and wdith in pixels
                quality = { # builds a dict containing width/hieght image dims which we check against imin size
                    "width": w, "height": h,
                    "brightness": float(arr.mean()), #avg pixel intensity, lover val --> darker image and vice versa 
                    "sharpness": float(laplace(arr).var()),  # variance of Laplacian; low = blurry, asusme higher val means more edges therefore lower val are indicitive of blur
                    "problems": [], # empty list but can fill with stuff like "too dark" or "too much blur" etc. useful for why image may be binned.
                }
                if min(w, h) < self.min_side: #if the image given is smaller than the minimum allowed then quality field 'problems' is updated with 'too small' and the assoicated dimensions.
                    quality["problems"].append(f"too small ({w}x{h})")
                lo, hi = self.brightness_lim #Brightness limits assigned to lo / hi
                if not lo <= quality["brightness"] <= hi: #if image brightness falls outside acceptable ranges then it gets booted
                    quality["problems"].append(f"brightness {quality['brightness']:.0f} outside {lo}-{hi}")

                if quality["problems"]:
                    return {"quality": quality, "status": "rejected_quality"} # If there are any problems then the status attribute of dict quality gets set to rejected .

                prepared = image.convert("RGB").resize((224, 224), Image.Resampling.BICUBIC) #Convert the image to RGB format and resize to 224x24 for vit input and resample the image as it smooths the spatial transitions of positional embeddings
                prepared_path = state["image_path"] + ".prepared.png"
                prepared.save(prepared_path)
        except (UnidentifiedImageError, OSError) as e:
            return {"quality": {"problems": [f"unreadable: {e}"]}, "status": "rejected_quality"} #if image cant be read this is sent back as quality problem in to the dict.

        return {"image_path": prepared_path, "quality": quality, "status": "ready"}

    def predict_image(self, state: AuditState) -> dict:
        with Image.open(state["image_path"]) as image:
            x = self.transform(image.convert("RGB")).unsqueeze(0) #for ViT need to add another dimension at the start for batch ,so it goes from [c,h,w] to [b, c, h ,w] also converts greyscale to RGB values.

        device = next(self.model.parameters()).device
        self.model.eval() #put model in to eval mode so no dropout etc 
        with torch.no_grad(): # inference only no autograd graph
            logits = self.model(x.to(device))[0].cpu() #Run foward pass over the model and extract the output back to the cpu

        probs = torch.softmax(logits, dim=0) #Probability for each class
        label = int(probs.argmax()) #Output class
        return {
            "logits": logits.tolist(),
            "prediction": {
                "label": label,
                "class_name": CLASS_NAMES[label],
                "confidence": float(probs[label]),
                "probs": probs.tolist(),
            },
            "attempt": 0,
            "status": "predicted",
        }

    def ood_detect(self, state: AuditState) -> dict:
        logits = torch.tensor(state["logits"])
        energy = float(-torch.logsumexp(logits, dim=0))
        is_ood = energy > self.energy_threshold
        return {"energy": energy, "ood_flag": is_ood,
                "status": "abstain" if is_ood else "in_distribution"}

