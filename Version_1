class AuditState(TypedDict, total=False):
  case_id : str #Stable ID; used in the checkpoint thread_id
  image_path : str # A path, not the image
  model_key: str 
  interactive : bool #True = pause for a human at human_review

  quality: dict # Check image sharpess, brightness, arttefact/lesion fractions, problems
  prediction: dict # classify: raw + calibrated P(melanoma), entropy, OOD details, target class
  confidence : float #prediction confidence
  explanations: Annotated[List, operator.add] #XAI worker: one record per attempt
  attempt: int # 0 after first pass, 1 after 2nd pass
  agreement: float #audit, what is the speamean correlation beteween the three method smaps

  findings : list # Audit: id, check, severity, text, evidence
  rule_status : str
  status : str
  llm_review : dict

  reviewr : dict
  report : str
  
