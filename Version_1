import matplotlib.pyplot as plt

def make_overlay_panel(image_path, maps: dict) -> str:
    """Original X-ray plus one heatmap overlay per method, returned as base64 PNG."""
    with Image.open(image_path) as img:
        base = np.asarray(img.convert("L").resize((224, 224)))

    fig, axes = plt.subplots(1, len(maps) + 1, figsize=(4 * (len(maps) + 1), 4))
    axes[0].imshow(base, cmap="gray"); axes[0].set_title("original")
    for ax, (name, m) in zip(axes[1:], maps.items()):
        ax.imshow(base, cmap="gray")
        ax.imshow(m / m.max(), cmap="jet", alpha=0.4)   # rescale for display only
        ax.set_title(name)
    for ax in axes:
        ax.axis("off")

    buf = io.BytesIO()
    fig.savefig(buf, format="png", bbox_inches="tight", dpi=100)
    plt.close(fig)
    return base64.b64encode(buf.getvalue()).decode()

def pooled(m, grid=14):
    """Average-pool to the ViT patch grid (14x14). Pixel-level Spearman is dominated by
    noise and by occlusion's blocky ties; patch level is the resolution the model actually 'sees'."""
    t = torch.from_numpy(m)[None, None]
    return F.adaptive_avg_pool2d(t, grid)[0, 0].numpy().ravel()


def method_agreement(maps: dict) -> dict:
    """Pairwise Spearman rho between methods, plus the mean."""
    names = sorted(maps)
    pairwise = {}
    for i, a in enumerate(names):
        for b in names[i + 1:]:
            rho, _ = spearmanr(pooled(maps[a]), pooled(maps[b]))
            pairwise[f"{a}_vs_{b}"] = float(rho)
    return {"pairwise": pairwise,
            "mean_rho": float(np.mean(list(pairwise.values())))}

def dispatch_xai(state: AuditState):
    """Fan out one XAI task per method for the predicted class."""
    pred = state["prediction"]
    return [Send("run_xai", XAITask(
        case_id=state["case_id"], image_path=state["image_path"],
        model_key=state.get("model_key", "cxr_vit"), method=method,
        target=pred["label"], class_name=pred["class_name"],
        confidence=pred["confidence"], alt=False, attempt=state.get("attempt", 0),
    )) for method in METHODS]


def run_xai(task: XAITask) -> dict:
    x = load_input(task["image_path"]).to(device)
    raw, extra = XAI_RUNNERS[task["method"]](model, x, task["target"])
    m = normalise_map(raw)

    # Store the map on disk rather than in state: state is checkpointed by MemorySaver,
    # and a list of 224x224 arrays bloats every checkpoint.
    map_path = f"{task['image_path']}.{task['method']}.a{task['attempt']}.npy"
    np.save(map_path, m)

    return {"explainations": [{
        "method": task["method"], "attempt": task["attempt"], "target": task["target"],
        "map_path": map_path, **summarise_map(m), **extra,
    }]}


def compare_methods(state: AuditState) -> dict:
    attempt = state.get("attempt", 0)
    current = [e for e in state["explainations"] if e["attempt"] == attempt]  # ignore earlier retries
    maps = {e["method"]: np.load(e["map_path"]) for e in current}
    return {"agreement": method_agreement(maps)}

def llm_review(state: AuditState) -> dict:
    evidence = build_evidence(state)
    attempt = state.get("attempt", 0)
    maps = {e["method"]: np.load(e["map_path"])
            for e in state["explainations"] if e["attempt"] == attempt}
    panel_b64 = make_overlay_panel(state["image_path"], maps)

    review = reviewer_llm.invoke([
        ("system", SYSTEM_PROMPT),
        {"role": "user", "content": [
            {"type": "image",
             "source": {"type": "base64", "media_type": "image/png", "data": panel_b64}},
            {"type": "text", "text": json.dumps(evidence, indent=2)},
        ]},
    ])
    return {"llm_review": review.model_dump(), "status": "llm_reviewed"}

def build_evidence(state: AuditState) -> dict:
    """Collect only what the LLM needs: numbers and labels, no maps or file paths."""
    attempt = state.get("attempt", 0)
    methods = {
        e["method"]: {k: round(v, 3) for k, v in e.items()
                      if k in ("border_frac", "top10_frac", "ig_convergence_delta")}
        for e in state["explainations"] if e["attempt"] == attempt
    }
    return {
        "prediction": {k: state["prediction"][k] for k in ("class_name", "confidence")},
        "energy": round(state["energy"], 3),
        "energy_threshold": round(ENERGY_THRESHOLD, 3),
        "image_quality": {k: state["quality"][k] for k in ("brightness", "sharpness")},
        "methods": methods,
        "agreement": state["agreement"],
    }


SYSTEM_PROMPT = """You are auditing a Vision Transformer that classifies frontal chest radiographs
as NORMAL or PNEUMONIA. Your audience is a radiologist reviewing whether the model's
reasoning can be trusted. Write in clinical language.

You receive:
1. An image panel: the original radiograph, then the same image with a heatmap overlay
   for each saliency method (Grad-CAM, Integrated Gradients, Occlusion). Warm colours = more important.
2. Supporting statistics for each method.

Your primary evidence is the image panel. For each method, describe WHERE it attends in
anatomical terms (zones, hila, cardiac silhouette, costophrenic angles, hemidiaphragms,
chest wall, outside the thorax) and WHAT is visible there on the radiograph.
Use radiological convention: the patient's right is on the image left.

Judge clinical plausibility:
- PNEUMONIA is plausibly supported by attention on lung parenchyma, particularly areas of
  increased opacity or consolidation.
- NORMAL is plausibly supported by attention spread across clear, well-aerated lung fields.
- Implausible bases: laterality markers, text, tubes or lines, image borders, soft tissue
  outside the thorax, or attention confined to the heart or diaphragm.

How to use the statistics (supporting evidence only; cite them in brackets):
- border_frac: attribution mass in the outer 10% band. A uniform map gives 0.36. This is a
  reference point, not a threshold; only values well above it suggest border reliance.
- top10_frac: mass in the top 10% of pixels. Uniform = 0.10, sharply focused = near 1.
- zones / top_zones: mass in each of 9 chest zones (uniform = 0.111 each).
- agreement.mean_rho: patch-level Spearman correlation between methods. Note that Grad-CAM
  on a ViT is coarse (14x14 patches) and Integrated Gradients is often speckled, so low
  correlation can reflect method resolution; check the overlays to see whether they
  actually disagree about the region.
- ig_convergence_delta: large values mean the IG attribution is numerically unreliable.
- energy: below energy_threshold means the image resembles the training data.

Describe what you see; do not make your own diagnosis. If something cannot be judged from
the image (e.g. overlay too diffuse), say so rather than guessing."""

